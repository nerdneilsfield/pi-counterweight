{
  "name": "pi-counterweight",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": ["./src/adapters/pi/index.ts"]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "test:serial": "vitest run --no-file-parallelism",
    "probe-cache": "node --experimental-strip-types src/cli/probe-cache.ts",
    "observe": "node dist/src/cli/observe.js"
  },
  "dependencies": {
    "smol-toml": "1.8.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "^22.0.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
